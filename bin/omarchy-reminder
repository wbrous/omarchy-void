#!/bin/bash

# omarchy:summary=Set and show lightweight desktop notification reminders
# omarchy:args=<minutes> [message] | show | clear
# omarchy:examples=omarchy reminder 5 | omarchy reminder 30 "Check the oven" | omarchy reminder show | omarchy reminder clear

set -euo pipefail

format_remaining() {
  local seconds=$1
  local minutes=$((seconds / 60))
  local remainder=$((seconds % 60))

  if ((minutes > 0 && remainder > 0)); then
    echo "${minutes}m ${remainder}s"
  elif ((minutes > 0)); then
    echo "${minutes}m"
  else
    echo "${remainder}s"
  fi
}

show_reminders() {
  local body="" now=$(date +%s)
  local reminder_dir="${XDG_RUNTIME_DIR:-/tmp}/omarchy-reminders"

  for job_file in "$reminder_dir"/omarchy-reminder-*.job; do
    [[ -f $job_file ]] || continue

    local unit=${job_file##*/}
    unit=${unit%.job}
    local message_file="$reminder_dir/$unit.message"
    local scheduled_epoch reminder_message reminder_minutes

    scheduled_epoch=$(awk '{print $NF}' "$job_file")
    remaining=$((scheduled_epoch - now))
    ((remaining <= 0)) && continue

    reminder=${unit#omarchy-reminder-}
    reminder_minutes=${reminder%%m-*}

    reminder_message=""
    [[ -f $message_file ]] && reminder_message=$(<"$message_file")

    if [[ -n $reminder_message ]]; then
      body+="$reminder_message in $(format_remaining $remaining) ($(date -d "@$scheduled_epoch" +%-H:%M))"$'\n'
    else
      body+="${reminder_minutes}-min reminder in $(format_remaining $remaining) ($(date -d "@$scheduled_epoch" +%-H:%M))"$'\n'
    fi
  done

  if [[ -z $body ]]; then
    omarchy-notification-send -g 󰔛 "Upcoming reminders" "No outstanding reminders"
  else
    omarchy-notification-send -g 󰔛 "Upcoming reminders" "${body%$'\n'}"
  fi
}

clear_reminders() {
  local reminder_dir="${XDG_RUNTIME_DIR:-/tmp}/omarchy-reminders"

  for job_file in "$reminder_dir"/omarchy-reminder-*.job; do
    [[ -f $job_file ]] || continue
    local job_num
    job_num=$(awk '{print $1}' "$job_file")
    [[ -n $job_num && $job_num =~ ^[0-9]+$ ]] && atrm "$job_num" 2>/dev/null || true
  done

  rm -f "$reminder_dir"/omarchy-reminder-*.job 2>/dev/null || true
  rm -f "$reminder_dir"/omarchy-reminder-*.message 2>/dev/null || true
  omarchy-notification-send -g 󰔛 "All reminders have been cleared"
}

case ${1:-} in
show | list)
  show_reminders
  exit 0
  ;;
clear)
  clear_reminders
  exit 0
  ;;
esac

minutes=${1:-}
shift || true
message="$*"
custom_message="$message"

if [[ -z $minutes ]] || [[ ! $minutes =~ ^[0-9]+$ ]] || ((minutes == 0)); then
  echo "Usage: omarchy-reminder <minutes> [message]"
  echo "       omarchy-reminder show"
  echo "       omarchy-reminder clear"
  exit 1
fi

if [[ -z $message ]]; then
  message="Your ${minutes} minutes are up"
fi

set_at=$(date +%s)
remind_at=$(date -d "+${minutes} minutes" +%H:%M)
unit="omarchy-reminder-${minutes}m-$set_at"
reminder_dir="${XDG_RUNTIME_DIR:-/tmp}/omarchy-reminders"
message_file="$reminder_dir/$unit.message"
job_file="$reminder_dir/$unit.job"
confirmation="You'll be reminded at $remind_at"
confirmation_title="Reminder set for ${minutes} minutes"

mkdir -p "$reminder_dir"

if [[ -n $custom_message ]]; then
  printf "%s" "$custom_message" >"$message_file"
  confirmation_title="$custom_message in ${minutes} minutes"
fi

scheduled_epoch=$(date -d "+${minutes} minutes" +%s)

# Create job file placeholder (at command will remove both files when it fires)
echo "PLACEHOLDER $scheduled_epoch" >"$job_file"

# Schedule the reminder with at, capture job number
job_output=$(echo "omarchy-notification-send -g 󰔛 'Reminder' '$message' -u critical; rm -f '$message_file' '$job_file'" | at now + "$minutes" minutes 2>&1)
job_num=$(echo "$job_output" | sed -n 's/.*job \([0-9]\+\).*/\1/p')

if [[ -n $job_num ]]; then
  echo "$job_num $scheduled_epoch" >"$job_file"
fi

omarchy-notification-send -g 󰔛 "$confirmation_title" "$confirmation"
