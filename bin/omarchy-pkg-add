#!/bin/bash

# omarchy:summary=Install Void packages if they are missing
# omarchy:args=<packages...>
# omarchy:examples=omarchy pkg add jq ripgrep
# omarchy:requires-sudo=true

if omarchy-pkg-missing "$@"; then
  sudo xbps-install -y "$@" || exit 1
fi

for pkg in "$@"; do
  # Secondary check to handle states where xbps-install doesn't actually register an error
  if ! xbps-query -s "$pkg" &>/dev/null; then
    echo -e "\033[31mError: Package '$pkg' did not install\033[0m" >&2
    exit 1
  fi
done

exit 0
