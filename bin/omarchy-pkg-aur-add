#!/bin/bash

# omarchy:summary=Add the named packages to the system from void-packages/xbps-src if they're missing. Returns false if it couldn't be done.
# omarchy:args=<packages...>

if omarchy-pkg-missing "$@"; then
  echo "Warning: xbps-src is not set up yet for Void Linux." >&2

  for pkg in "$@"; do
    if xbps-query -Rs "$pkg" &>/dev/null; then
      echo "Package '$pkg' is available in Void repositories." >&2
    else
      echo "Package '$pkg' is not available in Void repositories." >&2
    fi
  done

  exit 1
fi

for pkg in "$@"; do
  # Secondary check to handle states where xbps-src doesn't actually register an error
  if ! xbps-query -s "$pkg" &>/dev/null; then
    echo -e "\033[31mError: Package '$pkg' did not install\033[0m" >&2
    exit 1
  fi
done

exit 0
