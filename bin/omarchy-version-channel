#!/bin/bash

# omarchy:summary=Print the active Void Linux repository configuration

# Read repository URLs from xbps configuration
repos=$(cat /etc/xbps.d/*.conf /usr/share/xbps.d/*.conf 2>/dev/null | grep '^repository=' | cut -d= -f2)

if echo "$repos" | grep -q "musl"; then
  echo "musl"
elif echo "$repos" | grep -q "current"; then
  echo "stable"
else
  echo "unknown"
fi
