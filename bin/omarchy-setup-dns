#!/bin/bash

# omarchy:summary=Configure the system DNS provider
# omarchy:args=[Cloudflare|Google|DHCP|Custom]
# omarchy:requires-sudo=true

if [[ -z $1 ]]; then
  dns=$(gum choose --height 6 --header "Select DNS provider" Cloudflare Google DHCP Custom)
else
  dns=$1
fi

case "$dns" in
Cloudflare)
  sudo tee /etc/resolvconf.conf >/dev/null <<'EOF'
name_servers="1.1.1.1 1.0.0.1 2606:4700:4700::1111 2606:4700:4700::1001"
EOF
  sudo resolvconf -u
  ;;

Google)
  sudo tee /etc/resolvconf.conf >/dev/null <<'EOF'
name_servers="8.8.8.8 8.8.4.4 2001:4860:4860::8888 2001:4860:4860::8844"
EOF
  sudo resolvconf -u
  ;;

DHCP)
  if [[ -f /etc/resolvconf.conf ]]; then
    sudo rm -f /etc/resolvconf.conf
  fi
  sudo resolvconf -u
  ;;

Custom)
  echo "Enter your DNS servers (space-separated, e.g. '192.168.1.1 1.1.1.1'):"
  read -r dns_servers

  if [[ -z $dns_servers ]]; then
    echo "Error: No DNS servers provided."
    exit 1
  fi

  sudo tee /etc/resolvconf.conf >/dev/null <<EOF
name_servers="$dns_servers"
EOF
  sudo resolvconf -u
  ;;
esac
