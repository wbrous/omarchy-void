#!/bin/bash

# omarchy:summary=Show a fuzzy-finder TUI for picking new Void packages to install.
# omarchy:requires-sudo=true

fzf_args=(
  --multi
  --preview 'xbps-query -RS {1}'
  --preview-label='alt-p: toggle description, alt-j/k: scroll, tab: multi-select'
  --preview-label-pos='bottom'
  --preview-window 'down:65%:wrap'
  --bind 'alt-p:toggle-preview'
  --bind 'alt-d:preview-half-page-down,alt-u:preview-half-page-up'
  --bind 'alt-k:preview-up,alt-j:preview-down'
  --color 'pointer:green,marker:green'
)

pkg_names=$(xbps-query -Rs '' | awk '{print $2}' | sed 's/-[^-]*_[0-9]*$//' | fzf "${fzf_args[@]}")

if [[ -n $pkg_names ]]; then
  source omarchy-sudo-keepalive

  # Convert newline-separated selections to space-separated for xbps-install
  echo "$pkg_names" | tr '\n' ' ' | xargs sudo xbps-install -y
  omarchy-show-done
fi
