#!/bin/bash

# omarchy:summary=Restart Walker and related user services

restart_services() {
  pkill -x elephant || true
  pkill -x walker || true
  elephant --gapplication-service >/dev/null 2>&1 &
  walker --gapplication-service >/dev/null 2>&1 &
}

if (( EUID == 0 )); then
  SCRIPT_OWNER=$(stat -c '%U' "$0")
  su - "$SCRIPT_OWNER" -c "$(declare -f restart_services); restart_services"
else
  restart_services
fi
