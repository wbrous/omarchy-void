#!/bin/bash

# omarchy:summary=Print when system packages were last upgraded

# Use the timestamp of the xbps package database as a proxy for last update
last_update=$(stat -c %Y /var/db/xbps 2>/dev/null || echo 0)
if (( last_update > 0 )); then
  date -d "@$last_update" "+%A, %B %d %Y at %H:%M"
else
  echo "Unknown"
fi
